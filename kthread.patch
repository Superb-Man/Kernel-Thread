+
+uint64
+sys_join_thread(void) {
+  int id ;
+  argint(0,&id) ;
+  return join_thread(id) ;
+}
+
+uint64
+sys_yield(void) {
+  int x ;
+  argint(0,&x) ;
+  yield() ;
+  return 0 ;
+}
+
+uint64
+sys_release_sleep(void) {
+  uint64 addr ;
+  argaddr(0, &addr) ;
+  new_sleep(addr) ;
+
+  return 0 ;
+}
+
+uint64
+sys_wakeup(void) {
+  int id ;
+  argint(0, &id) ;
+  new_wakeup(id) ;
+  return 0 ;
+}
