+uint64
+sys_create_thread(void) {
+  uint64 fcn ;
+  uint64 arg ;
+  uint64 stack ;
+  argaddr(0, &fcn) ; 
+  argaddr(1 , &arg) ;
+  argaddr(2, &stack) ;
+
